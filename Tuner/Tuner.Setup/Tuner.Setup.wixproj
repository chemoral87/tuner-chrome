<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Tuner</OutputName>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!-- Platform-specific settings -->
  <!-- Default to x64 for Any CPU, empty, or x64; use x86 only when explicitly set -->
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <InstallerPlatform>x86</InstallerPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' != 'x86'">
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <!-- Pass PublishFolder as WiX preprocessor variable via DefineConstants -->
  <PropertyGroup Condition="'$(InstallerPlatform)' == 'x64'">
    <DefineConstants>$(DefineConstants);PublishFolder=publish-x64</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InstallerPlatform)' == 'x86'">
    <DefineConstants>$(DefineConstants);PublishFolder=publish-x86</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tuner.csproj" />
  </ItemGroup>

  <!-- Print MSI output path after build -->
  <Target Name="ShowMsiPath" AfterTargets="Build">
    <Message Text="✅ Installer created: $(MSBuildProjectDirectory)\$(OutputPath)$(OutputName).msi" Importance="high" />
  </Target>
</Project>
