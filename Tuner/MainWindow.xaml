<Window x:Class="Tuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chromatic Tuner" 
        Width="480" Height="480"
        ResizeMode="CanMinimize"
        Background="Black"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />  <!-- Pitch tracker -->
            <RowDefinition Height="*" />    <!-- Spectrum analyzer -->
        </Grid.RowDefinitions>

        <!-- Top: Pitch tracker -->
        <Grid Grid.Row="0">
            <Canvas x:Name="PitchCanvas" Background="Black" />

            <!-- Detected note display (large text) -->
            <TextBlock x:Name="NoteDisplay"
                       Canvas.Left="290" Canvas.Top="10"
                       FontSize="32" FontWeight="Bold"
                       Foreground="#B3E5E5E5"
                       Text="" />

            <!-- Cents + Hz display -->
            <TextBlock x:Name="CentsDisplay"
                       Canvas.Left="290" Canvas.Top="48"
                       FontSize="12"
                       Foreground="#B3E5E5E5"
                       Text="" />

            <!-- Bottom note display (mirrors top) -->
            <TextBlock x:Name="NoteDisplayBottom"
                       Canvas.Left="290" Canvas.Bottom="10"
                       FontSize="32" FontWeight="Bold"
                       Foreground="#B3E5E5E5"
                       Text="" />

            <!-- Notation mode selector -->
            <ComboBox x:Name="NotationSelector" 
                      Canvas.Left="0" Canvas.Top="0"
                      Width="260" Height="24"
                      Background="Black"
                      Foreground="#8B8685"
                      SelectedIndex="0"
                      SelectionChanged="NotationSelector_SelectionChanged">
                <ComboBoxItem Content="Pitch notation: Roland (C4 = middle C)" IsSelected="True" />
                <ComboBoxItem Content="Pitch notation: Yamaha (C3 = middle C)" />
                <ComboBoxItem Content="Pitch notation: Cakewalk (C5 = middle C)" />
            </ComboBox>

            <!-- Calibration slider (visible on hover) -->
            <Grid x:Name="CalibrationPanel"
                  Canvas.Left="0" Canvas.Top="28"
                  Width="260" Height="32"
                  Opacity="0"
                  Background="#CC000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="A4="
                           FontSize="11" Foreground="#8B8685"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0" />

                <Slider x:Name="CalibrationSlider"
                        Grid.Column="1"
                        Minimum="430" Maximum="450"
                        Value="440"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="CalibrationSlider_ValueChanged"
                        VerticalAlignment="Center"
                        Margin="4,0" />

                <TextBlock x:Name="CalibrationValue"
                           Grid.Column="2"
                           Text="440 Hz"
                           FontSize="11" Foreground="#8B8685"
                           VerticalAlignment="Center"
                           Width="55"
                           TextAlignment="Right"
                           Margin="0,0,5,0" />
            </Grid>

            <!-- Status bar -->
            <TextBlock x:Name="StatusText"
                       Canvas.Left="10" Canvas.Bottom="10"
                       FontSize="12" Foreground="#888"
                       Text="" />
        </Grid>

        <!-- Bottom: Spectrum analyzer -->
        <Grid Grid.Row="1">
            <Border BorderBrush="#333" BorderThickness="0,1,0,0">
                <Grid>
                    <Canvas x:Name="SpectrumCanvas" Background="Black" />

                    <!-- Frequency labels along the bottom -->
                    <TextBlock x:Name="SpectrumLabelLeft"
                               FontSize="10" Foreground="#555"
                               Text="20 Hz"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="5,0,0,2" />
                    <TextBlock x:Name="SpectrumLabelMid"
                               FontSize="10" Foreground="#555"
                               Text="1 kHz"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="SpectrumLabelRight"
                               FontSize="10" Foreground="#555"
                               Text="20 kHz"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,5,2" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
